{
  "name": "fleetharness",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-assisted software factory for operational challenges",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc && vite build && npm run build:electron",
    "build:web": "tsc && vite build --outDir dist-web --base /",
    "icons": "node scripts/create-icon.mjs",
    "start": "electron .",
    "preview": "vite preview",
    "test": "npm run build:electron && npm run build:worker && node --test --test-concurrency=2 tests/*.test.mjs",
    "setup:browser": "playwright install chromium",
    "test:flow": "npm run build:electron && node --test tests/agent-runner.test.mjs tests/pi-backend.test.mjs tests/pi-sdk.test.mjs tests/verification.test.mjs",
    "test:conversation": "npm run build && node scripts/smoke-conversation.mjs",
    "test:budgets": "npm run build:electron && node --test --test-concurrency=2 tests/run-budget.test.mjs tests/run-usage.test.mjs tests/agent-runner.test.mjs tests/pi-backend.test.mjs tests/pi-sdk.test.mjs tests/codex-session.test.mjs tests/verification.test.mjs",
    "test:budgets:ui": "npm run build && node scripts/smoke-run-budgets.mjs && node scripts/smoke-build-budget-desktop.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && node scripts/build-windows.mjs",
    "dist:win:baseline": "npm run build && node scripts/build-windows.mjs --baseline",
    "test:windows": "node scripts/smoke-windows.mjs",
    "sync:norfolk": "node scripts/sync-norfolk.mjs",
    "test:norfolk": "npm run build && node --test tests/norfolk.test.mjs && node scripts/smoke-norfolk.mjs",
    "harness:build": "tsc -p harness/tsconfig.json",
    "harness": "npm run harness:build --silent && node dist-harness/harness/cli.js",
    "test:harness": "npm run harness:build && node --test dist-harness/tests/harness*.test.js",
    "test:foundations": "npm run build:electron && node scripts/check-foundations.mjs && node --test tests/foundations.test.mjs",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "test:brief-data": "npm run build && node scripts/smoke-brief-data.mjs",
    "test:system-design": "npm run build && node scripts/smoke-system-design.mjs",
    "test:activity": "npm run build && node scripts/smoke-activity.mjs",
    "test:visual-review": "npm run build && node --test tests/visual-review.test.mjs && node scripts/smoke-visual-review.mjs",
    "test:chatgpt": "npm run build && node scripts/smoke-chatgpt.mjs",
    "test:models": "npm run build && node scripts/smoke-model-selector.mjs",
    "test:executable": "npm run build && node scripts/smoke-executable.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build:hosted": "npm run build:worker && node scripts/stage-worker.mjs && tsc && tsc -p tsconfig.hosted.json && vite build --config vite.hosted.config.ts && npm run test:hosted-build",
    "dev:hosted": "vite --config vite.hosted.config.ts --host 127.0.0.1",
    "test:hosted": "npm run build:worker && node --test tests/hosted-*.test.mjs src/hosted-client.test.mjs",
    "test:hosted-build": "node scripts/check-hosted-workflow.mjs",
    "test:solutions": "npm run build:electron && node --test tests/solution-*.test.mjs tests/factory-benchmark.test.mjs",
    "benchmark:factory": "npm run build:electron && node scripts/benchmark-factory.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@electron/packager": "20.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@openai/codex": "0.166.0",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/sandbox": "3.9.1",
    "koffi": "3.3.6",
    "lru-cache": "10.4.3",
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
    "nitro": "3.0.261103-rc",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27",
    "undici": "7.30.1",
    "unstorage": "2.0.0-alpha.10",
    "workflow": "5.3.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "acorn": "8.16.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "dev.fleetharness.desktop",
    "productName": "AppYard",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "skills/**/*",
      "templates/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AppYard-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "differentialPackage": false
    },
    "artifactName": "AppYard-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*",
      "dist-electron/electron/package-worker.js",
      "package.json"
    ]
  },
  "author": "AppYard",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "undici@^7.0.0": "7.30.1",
    "zod@^4.0.0": "4.6.7"
  }
}
