            "sourceCriterionId": "UC12-1",
            "name": "frequency plans"
          },
          {
            "sourceCriterionId": "UC12-1",
            "name": "crypto change-over windows"
          },
          {
            "sourceCriterionId": "UC12-1",
            "name": "flight quarters event times"
          },
          {
            "sourceCriterionId": "UC12-1",
            "name": "consolidated visual timeline"
          }
        ]
      }
    },
