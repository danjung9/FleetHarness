      "disposition": "deferred",
      "expectedOutcome": "Real USMTF raw text extraction of every named category into a consolidated timeline remains unverified. The complete synthetic three-category transformation is demonstrated, not counted as real-format validation.",
      "journeyIds": [],
      "capabilityIds": [],
