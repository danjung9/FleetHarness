{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC12-1",
      "disposition": "implemented",
      "expectedOutcome": "Within the explicit invented synthetic grammar, the raw sample yields F1 frequency plan 251.5 MHz at 08:00–12:00 UTC, C1 crypto change-over KEY-DEMO-A at 09:30–09:45 UTC, and A1 flight quarters 23:30–00:30 UTC; all three appear on a synchronized 24-hour timeline with source review. This does not establish real USMTF conformance.",
      "journeyIds": [
        "daily-schedule",
        "source-trace"
      ]
    },
    {
      "criterionId": "MSG-01",
      "disposition": "implemented",
      "expectedOutcome": "Every extracted field retains exact zero-based end-exclusive UTF-16 offsets into unchanged source. F1 id is [5,7) and start is [8,25) in the source-trace fixture; all fields are checked by actual-core Node tests, including mixed line endings and non-ASCII.",
      "journeyIds": [
        "source-trace"
      ]
    },
    {
      "criterionId": "MSG-02",
      "disposition": "implemented",
      "expectedOutcome": "Empty input is rejected; missing zones, invalid dates and unsupported lines are explicit issues, never guessed event times. Editing source preserves the previous revision, invalidates review, and reparsing valid input recovers the literal schedule.",
      "journeyIds": [
        "ambiguous-recovery",
        "invalid-calendar-recovery",
        "dirty-review"
      ]
    },
    {
      "criterionId": "MSG-03",
      "disposition": "implemented",
      "expectedOutcome": "10:00+02:00 and 08:00Z normalize to 08:00 UTC; a 23:30Z–00:30Z interval remains 60 minutes, showing 30 minutes on each adjoining UTC day with continuation labels and explicit outside-day count.",
      "journeyIds": [
        "timezone-day"
      ]
    },
    {
      "criterionId": "MSG-04",
      "disposition": "implemented",
      "expectedOutcome": "Actual application output is compared against the separate planning-authored held-out synthetic key: expected/extracted/matched 3, false positives/missed 0, precision/recall 100%, field/time/span discrepancies 0, and 2 non-event lines produce no events and 1 unsupported warning. A deliberate local review acknowledgement is recorded; independent human/SME assessment remains a separate evidence boundary.",
      "journeyIds": [
        "held-out-comparison"
      ]
    },
    {
      "criterionId": "MSG-05",
      "disposition": "implemented",
      "expectedOutcome": "The locally opened dependency-free application supports parsing, source inspection, review, saved-state reload and UTF-8 reviewed schedule export without any network resource. The primary journey exports optask-2026-11-04.json containing the synthetic disclosure and retained provenance. Disconnected-runtime validation is an additional verification gate, not established merely by this declarative journey.",
      "journeyIds": [
        "daily-schedule",
        "source-trace",
        "dirty-review"
      ]
    },
    {
      "criterionId": "DELIVERABLE12-1",
      "disposition": "implemented",
      "expectedOutcome": "A user converts mock USMTF-style raw text into the reviewed synchronized 24-hour schedule for all three named categories, saves and reloads it, and exports its full intervals and provenance. Original source, pending corrections and committed review remain distinct. All outputs disclose synthetic, not validated against the real format.",
      "journeyIds": [
        "daily-schedule",
        "timezone-day",
        "dirty-review"
      ]
    }
  ],
