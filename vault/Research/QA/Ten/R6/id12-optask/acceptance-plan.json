{
  "schemaVersion": 2,
  "criteria": [
    {
      "criterionId": "UC12-1",
      "disposition": "implemented",
      "expectedOutcome": "Under the authorized synthetic-only boundary, the complete SYN-OPTASK/1 mock USMTF-style workflow extracts frequency plans, crypto change-over windows and flight quarters event times with exact source evidence and plots them on a consolidated visual timeline. Nominal input yields 4 events, 3 selected: FP-01 at 06:00–10:00, CW-01 at 08:00–08:15 and FQ-01 at 08:00–09:00 UTC. All three categories share a 00:00–24:00 UTC axis. Dense, overlapping, overnight, invalid and recovery inputs are evaluated. Synthetic; not validated against the real USMTF format. Actual-format and operational accuracy remain unverified evidence limits, not deferred core functionality.",
      "journeyIds": [
        "synthetic-primary",
        "dense-ship",
        "overnight"
      ],
      "capabilityIds": [
        "extract-evidence",
        "time-selection"
      ]
    },
    {
      "criterionId": "MSG-01",
      "disposition": "implemented",
      "expectedOutcome": "Every emitted field, category and message identity has exact UTF-16 evidence including Unicode/CRLF; nominal frequency slice [232,237) equals 312.5.",
      "journeyIds": [
        "synthetic-primary"
      ],
      "capabilityIds": [
        "extract-evidence"
      ]
    },
    {
      "criterionId": "MSG-02",
      "disposition": "implemented",
      "expectedOutcome": "Missing zone, impossible date, unsupported/malformed sets, empty draft and duplicates quarantine affected text, preserve original input and never infer timestamps; valid unrelated events survive.",
      "journeyIds": [
        "recover-source",
        "recover-unsaved"
      ],
      "capabilityIds": [
        "extract-evidence"
      ]
    },
    {
      "criterionId": "MSG-03",
      "disposition": "implemented",
      "expectedOutcome": "Equivalent explicit offsets give identical UTC instants; overnight clipping is 0–30 and 1425–1440 minutes with full source endpoints retained and boundary-only events excluded.",
      "journeyIds": [
        "overnight"
      ],
      "capabilityIds": [
        "time-selection"
      ]
    },
    {
      "criterionId": "MSG-04",
      "disposition": "implemented",
      "expectedOutcome": "Independent prebuild synthetic tuples, negatives and non-events achieve exact response score 1 and event precision/recall 1; no SME ground truth or real-format accuracy claimed.",
      "journeyIds": [
        "synthetic-primary"
      ],
      "capabilityIds": [
        "extract-evidence"
      ]
    },
    {
      "criterionId": "MSG-05",
      "disposition": "implemented",
      "expectedOutcome": "After initial cache activation, browser network disconnection still allows a newly edited raw message to be parsed through the identical core and reviewed JSON exported. An explicit offline-route journey plus actual browser disconnection check is required.",
      "journeyIds": [
        "offline-primary"
      ],
      "capabilityIds": [
        "review-export"
      ]
    },
    {
      "criterionId": "DELIVERABLE12-1",
