  "journeys": [
    {
      "id": "synthetic-primary",
      "title": "Extract, inspect exact evidence, save, review and export all three categories",
      "kind": "primary",
      "steps": [
        {
          "action": "select",
          "selector": "#sample",
          "value": "SYN-NOMINAL"
        },
        {
          "action": "click",
          "selector": "#load-sample"
        },
        {
          "action": "click",
          "selector": "#parse"
        },
        {
          "action": "expectText",
          "selector": "#source-credit",
          "text": "Source: https://cdao.hackathon.maximus.com/event/norfolk/use-cases/12"
        },
        {
          "action": "expectText",
          "selector": "#counts",
          "text": "4 extracted · 3 selected · 0 issues"
        },
        {
          "action": "expectText",
          "selector": "#frequency-output",
          "text": "FP-01 · TRAINING-NET-AM · 312.5 MHz · 06:00–10:00 UTC"
        },
        {
          "action": "expectText",
          "selector": "#crypto-output",
          "text": "CW-01 · FICTIONAL-LABEL-ALPHA-TO-BRAVO · 08:00–08:15 UTC"
        },
        {
          "action": "expectText",
          "selector": "#flight-output",
          "text": "FQ-01 · TRAINING-LAUNCH · 08:00–09:00 UTC"
        },
        {
          "action": "expectText",
          "selector": "#axis-label",
          "text": "2026-11-05 · FS AURORA · 00:00–24:00 UTC"
        },
        {
          "action": "click",
          "selector": "#source-FP-01-frequency"
        },
        {
          "action": "expectText",
          "selector": "#source-highlight",
          "text": "312.5"
        },
        {
          "action": "expectText",
          "selector": "#evidence-location",
          "text": "Line 6 · UTF-16 [232,237)"
        },
        {
          "action": "click",
          "selector": "#save-draft"
        },
        {
          "action": "expectText",
          "selector": "#save-status",
          "text": "Saved locally"
        },
        {
          "action": "reload"
        },
        {
          "action": "expectText",
          "selector": "#counts",
          "text": "4 extracted · 3 selected · 0 issues"
        },
        {
          "action": "check",
          "selector": "#reviewed"
        },
        {
          "action": "click",
          "selector": "#confirm-review"
        },
        {
          "action": "expectText",
          "selector": "#review-status",
          "text": "Reviewed draft · synthetic only"
        },
        {
          "action": "expectDownload",
          "selector": "#export",
          "fileName": "synthetic-schedule.json",
          "text": "\"reviewStatus\": \"reviewed-draft\""
        },
        {
          "action": "expectDownload",
          "selector": "#export",
          "text": "Synthetic; not validated against the real USMTF format."
        },
        {
          "action": "expectDownload",
          "selector": "#export",
          "text": "\"frequency\": 312.5"
        }
      ]
    },
    {
      "id": "recover-source",
      "title": "Reject missing timezone without guessing then correct and reparse",
      "kind": "recovery",
      "steps": [
        {
          "action": "select",
          "selector": "#ship",
          "value": "FS AURORA"
        },
        {
          "action": "fill",
          "selector": "#day",
          "value": "2026-11-05"
        },
        {
          "action": "fill",
          "selector": "#raw-text",
          "value": "SYNTHETIC OPTASK — NOT REAL USMTF\nMSGID/SYN-MISSING-ZONE//\nEXERCISE/GLASS HARBOR FICTION//\nTIMEZONE/EXPLICIT-ENDPOINT-OFFSETS//\nSUBJ/Fictional watch schedule//\nFLIGHTQ/FQ-BAD/FS AURORA/NO-ZONE/2026-11-05T08:00/2026-11-05T09:00//\nENDMSG//"
        },
        {
          "action": "click",
          "selector": "#parse"
        },
        {
          "action": "expectText",
          "selector": "#counts",
          "text": "0 extracted · 0 selected · 1 issues"
        },
        {
          "action": "expectText",
          "selector": "#issue-message",
          "text": "FQ-BAD: explicit timezone required on both endpoints."
        },
        {
          "action": "expectText",
          "selector": "#review-status",
          "text": "Resolve source issues before review"
        },
        {
          "action": "fill",
          "selector": "#raw-text",
          "value": "SYNTHETIC OPTASK — NOT REAL USMTF\nMSGID/SYN-NOMINAL//\nEXERCISE/GLASS HARBOR FICTION//\nTIMEZONE/EXPLICIT-ENDPOINT-OFFSETS//\nSUBJ/Fictional watch schedule//\nFREQPLAN/FP-01/FS AURORA/TRAINING-NET-AM/2026-11-05T06:00Z/2026-11-05T10:00Z/312.5/MHz//\nCRYPTO/CW-01/FS AURORA/FICTIONAL-LABEL-ALPHA-TO-BRAVO/2026-11-05T08:00Z/2026-11-05T08:15Z//\nFLIGHTQ/FQ-01/FS AURORA/TRAINING-LAUNCH/2026-11-05T08:00Z/2026-11-05T09:00Z//\nFLIGHTQ/FQ-02/FS LANTERN/TRAINING-RECOVERY/2026-11-05T15:00Z/2026-11-05T15:45Z//\nENDMSG//"
        },
        {
          "action": "click",
          "selector": "#parse"
        },
        {
          "action": "expectText",
          "selector": "#counts",
          "text": "4 extracted · 3 selected · 0 issues"
        },
        {
          "action": "expectText",
          "selector": "#frequency-output",
          "text": "FP-01 · TRAINING-NET-AM · 312.5 MHz · 06:00–10:00 UTC"
        },
        {
          "action": "expectText",
          "selector": "#crypto-output",
          "text": "CW-01 · FICTIONAL-LABEL-ALPHA-TO-BRAVO · 08:00–08:15 UTC"
        },
        {
          "action": "expectText",
          "selector": "#flight-output",
          "text": "FQ-01 · TRAINING-LAUNCH · 08:00–09:00 UTC"
        },
        {
          "action": "expectText",
          "selector": "#axis-label",
          "text": "2026-11-05 · FS AURORA · 00:00–24:00 UTC"
        },
        {
          "action": "expectText",
          "selector": "#review-status",
          "text": "Unreviewed draft"
        }
      ]
    },
    {
