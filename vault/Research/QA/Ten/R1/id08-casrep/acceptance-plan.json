{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC8-1",
      "disposition": "deferred",
      "expectedOutcome": "All six source roles enforce approved comment, return, approval and release permissions; INITIAL, UPDATE, CORRECT and CASCOR reports enforce the applicable approved NWP 1-03.1 category, required-field and message-format rules; every revision, comment and approval remains auditable with current routing visible, using notional unclassified data only.",
      "journeyIds": [],
      "reason": "Only a synthetic INITIAL workflow is planned. Approved NWP edition, required fields/categories, all report-type semantics and routing rules are missing; local persona selection is not authenticated access control. No compliance claim. The demonstrated subset is checked under WFL-01/02/03; full source coverage remains unverified."
    },
    {
      "criterionId": "WFL-01",
      "disposition": "implemented",
      "expectedOutcome": "An early or out-of-order release is denied without advancing state. Changing an approved revision removes every current approval, restarts review, and prevents release using the old decision. The corrected revision can complete fresh review and simulated CO release. Unsaved edits cannot be submitted or approved without deliberate save or discard.",
      "journeyIds": [
        "stale-approval",
        "recover-draft"
      ]
    },
    {
      "criterionId": "WFL-02",
      "disposition": "implemented",
      "expectedOutcome": "Two amendments from revision 1 remain separately readable across reload, with their common base visible. Explicit resolution stores the chosen combined text with both amendment heads as parents; both source contents survive reload and no prior approval carries into revision 4.",
      "journeyIds": [
        "resolve-amendments"
      ]
    },
    {
      "criterionId": "WFL-03",
      "disposition": "implemented",
      "expectedOutcome": "A reviewer can create an INITIAL synthetic report, return revision 1 with a retained reason, save revision 2, complete Division Officer, Department Head, CHENG, XO and CO review, reload the simulated released state and download the corrected content with traceable revision and review history. Human workflow acceptance remains separately pending.",
      "journeyIds": [
        "review-return-release",
        "recover-draft"
      ]
    },
    {
      "criterionId": "DELIVERABLE8-1",
      "disposition": "deferred",
      "expectedOutcome": "One mock CASREP completes every approval role through CO release including a return-for-revision loop, accompanied by a short demo video or delivered live walkthrough and a one-page brief explaining permissions, classification handling, Navy messaging integration and fielding prerequisites.",
      "journeyIds": [],
      "reason": "The build will supply a synthetic all-role simulated-release workflow, walkthrough script and one-page fielding brief, but no human-delivered walkthrough/video, acceptance of that brief or authorized formal CO release is available in this unattended local phase. The entire source deliverable remains unverified rather than equating a script/download with its completion."
    }
  ],
