{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "GOV-01",
      "disposition": "implemented",
      "expectedOutcome": "In the synthetic simulator, missing manifest, expired authorization lease (expiresAt=100 at t=100), and stale heartbeat each reject an intent with a distinct reason and zero executed actions. Explicit registration or renewal permits a fresh intent; repair subsequently executes exactly one action. These are simulated identity and authorization checks, not cryptographic verification.",
      "journeyIds": [
        "eligibility-recovery"
      ]
    },
    {
      "criterionId": "GOV-02",
      "disposition": "implemented",
      "expectedOutcome": "At t=100 under demo-v1 cruising policy, sensor score 60 beats repair score 40 for pump-1 in either arrival order with only one lease and one action. A 60/60 tie grants no lease and escalates; explicit repair promotion to 80 resolves it. General quarters gives repair 70 over sensor 60; returning to cruising and adding promotion 40 gives repair 80.",
      "journeyIds": [
        "reverse-contention",
        "tie-recovery",
        "condition-promotion"
      ]
    },
    {
      "criterionId": "GOV-03",
      "disposition": "implemented",
      "expectedOutcome": "After one completed action and two newly pending intents, one operator halt cancels pending work, records acknowledgement for both registered agents, rejects new intents and blocks execution. The executed count remains 1 and the completed sensor action remains visible, including after reload. This covers all agents in the local simulation and preserves a separate human review obligation.",
      "journeyIds": [
        "halt-persistence"
      ]
    }
  ],
  "journeys": [
    {
