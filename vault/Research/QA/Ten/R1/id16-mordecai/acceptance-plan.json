        },
        {
          "action": "click",
          "selector": "#submit-intent"
        },
        {
          "action": "expectText",
          "selector": "#intent-result",
          "text": "Rejected: agent ghost is not registered."
        },
        {
          "action": "expectText",
          "selector": "#executed-count",
          "text": "0"
        },
        {
          "action": "click",
          "selector": "#repair-eligibility"
        },
        {
          "action": "click",
          "selector": "#submit-intent"
        },
        {
          "action": "expectText",
          "selector": "#intent-result",
          "text": "Pending: ghost requests pump-1."
        },
        {
