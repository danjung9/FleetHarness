{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC12-1",
      "disposition": "implemented",
      "expectedOutcome": "Extract all three named categories directly from fictional pipe-delimited OPTASK text, review the mock type mapping and source evidence, and display overlapping intervals on a consolidated UTC timeline. Synthetic only; not validated against actual USMTF formats or operational rules.",
      "journeyIds": [
        "daily-schedule",
        "exclude-non-event",
        "answer-key"
      ]
    },
    {
      "criterionId": "MSG-01",
      "disposition": "implemented",
      "expectedOutcome": "Every source-derived field has a zero-based end-exclusive UTF-16 span into its immutable revision; the sample frequency start evidence is 2026-11-04T06:00:00Z. Derived values retain original-field links.",
      "journeyIds": [
        "daily-schedule"
      ]
    },
    {
      "criterionId": "MSG-02",
      "disposition": "implemented",
      "expectedOutcome": "Empty source is rejected; missing timezone, impossible calendar date and unsupported line produce distinct issues with zero invented events; explicit correction creates revision 2 and preserves revision 1. Draft changes block review and export.",
      "journeyIds": [
        "invalid-recovery",
        "exclude-non-event",
        "stale-review"
      ]
    },
    {
      "criterionId": "MSG-03",
      "disposition": "implemented",
      "expectedOutcome": "01:00 at -05:00 normalizes to 06:00Z; a 23:30–00:30 flight interval remains 60 minutes and displays 30 minutes on each UTC day.",
      "journeyIds": [
        "utc-boundary",
        "daily-schedule"
      ]
    },
    {
      "criterionId": "MSG-04",
      "disposition": "deferred",
      "expectedOutcome": "An independent person inspects the separately authored synthetic answer key, actual extraction, precision/recall denominators and discrepancies and records their review. A finite automated comparison is implemented but cannot establish independent human review.",
      "journeyIds": [],
      "deferralBasis": "human-authority",
      "reason": "Packet method is human. No independent person has performed or recorded inspection of the held-out synthetic key and actual application output. A generated score or model statement cannot stand in for that person’s review. The answer-key journey still demonstrates the complete synthetic comparison under UC12-1; MSG-04 remains unverified."
    },
    {
      "criterionId": "MSG-05",
      "disposition": "implemented",
      "expectedOutcome": "After opening the self-contained local file, parsing, review, timeline and both downloads require no network. Reload restores source and reviewed state when local storage is available.",
      "journeyIds": [
        "daily-schedule"
      ]
    },
    {
      "criterionId": "DELIVERABLE12-1",
      "disposition": "implemented",
      "expectedOutcome": "Convert the fictional raw message to the Synchronized 24-hour Visual Schedule with Frequency Plan, Crypto Change-over Window and Flight Quarters, a common 00:00–24:00 axis, accessible day list and reviewed CSV/traceability JSON exports.",
      "journeyIds": [
        "daily-schedule",
        "utc-boundary"
      ]
    }
  ],
  "journeys": [
    {
      "id": "daily-schedule",
      "title": "Extract, review and export the fictional OPTASK schedule",
      "kind": "primary",
      "steps": [
        {
          "action": "click",
          "selector": "#load-sample"
        },
        {
          "action": "click",
          "selector": "#parse"
        },
        {
          "action": "expectText",
          "selector": "#parse-summary",
          "text": "3 events extracted; 0 issues. Review required."
        },
        {
          "action": "expectText",
          "selector": "#mapping-summary",
          "text": "FREQPLAN → Frequency Plan; CRYPTO → Crypto Change-over Window; FLIGHTQTRS → Flight Quarters"
        },
        {
          "action": "click",
          "selector": "#evidence-FP-01-start"
        },
        {
          "action": "expectText",
          "selector": "#evidence-text",
          "text": "2026-11-04T06:00:00Z"
        },
        {
          "action": "expectText",
          "selector": "#evidence-range",
          "text": "UTF-16 [102, 122); line 2"
        },
        {
          "action": "check",
          "selector": "#mapping-reviewed"
        },
        {
          "action": "check",
          "selector": "#events-reviewed"
        },
        {
          "action": "click",
          "selector": "#commit-review"
        },
        {
          "action": "expectText",
          "selector": "#review-status",
          "text": "Reviewed synthetic revision 1."
        },
        {
          "action": "fill",
          "selector": "#schedule-day",
          "value": "2026-11-04"
        },
        {
          "action": "click",
          "selector": "#show-day"
        },
        {
          "action": "expectText",
          "selector": "#day-summary",
          "text": "2026-11-04 UTC · 3 events · 165 displayed minutes"
        },
        {
          "action": "expectText",
          "selector": "#schedule-FP-01",
          "text": "Frequency Plan · FP-01 · Training Alpha · 225.500 MHz · 06:00–08:00 UTC · 120 minutes"
        },
        {
          "action": "expectText",
          "selector": "#schedule-CW-01",
          "text": "Crypto Change-over Window · CW-01 · TRAINING-KEY-A to TRAINING-KEY-B · 07:30–07:45 UTC · 15 minutes"
        },
        {
          "action": "expectText",
          "selector": "#schedule-FQ-01",
          "text": "Flight Quarters · FQ-01 · Fictional deck drill · 23:30–24:00 UTC · 30 minutes · continues next day"
        },
        {
          "action": "expectVisible",
          "selector": "#timeline"
        },
        {
          "action": "expectText",
          "selector": "#overlap-summary",
          "text": "FP-01 and CW-01 overlap for 15 minutes."
        },
        {
          "action": "expectDownload",
          "selector": "#export-csv",
          "fileName": "reviewed-schedule.csv",
          "text": "2026-11-04T23:30:00.000Z,2026-11-05T00:30:00.000Z"
        },
        {
          "action": "expectDownload",
          "selector": "#export-json",
          "fileName": "extraction-review.json",
          "text": "SYNTHETIC-DEMO-01"
        },
        {
          "action": "reload"
        },
        {
          "action": "expectText",
          "selector": "#review-status",
          "text": "Reviewed synthetic revision 1."
        },
        {
          "action": "expectValue",
          "selector": "#source-input",
          "value": "OPTASK|SYNTHETIC-DEMO-01|Fictional training vessel Meridian\nFREQPLAN|FP-01|Training Alpha|225.500|MHz|2026-11-04T06:00:00Z|2026-11-04T08:00:00Z\nCRYPTO|CW-01|TRAINING-KEY-A to TRAINING-KEY-B|2026-11-04T07:30:00Z|2026-11-04T07:45:00Z\nFLIGHTQTRS|FQ-01|Fictional deck drill|2026-11-04T23:30:00Z|2026-11-05T00:30:00Z"
        }
      ]
    },
    {
