      "kind": "primary",
      "steps": [
        {
          "action": "fill",
          "selector": "#source-input",
          "value": "FREQPLAN|TZ-01|Training Alpha|225.500|MHz|2026-11-04T01:00:00-05:00|2026-11-04T08:00:00Z\nFLIGHTQTRS|NIGHT-01|Night drill|2026-11-04T23:30:00Z|2026-11-05T00:30:00Z"
        },
        {
          "action": "click",
          "selector": "#parse"
        },
        {
          "action": "check",
          "selector": "#mapping-reviewed"
