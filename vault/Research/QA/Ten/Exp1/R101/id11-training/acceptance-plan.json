{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC11-1",
      "disposition": "implemented",
      "expectedOutcome": "The complete labeled synthetic PB4T workflow uses Engineering, Weapons, Combat Systems, Damage Control and Flight Operations Agents to propose, reject and accept allocations against shared crew, resources, operational windows, synthetic fatigue and explicit mandatory occurrences. The baseline resolves the C01/Training Room collision by moving Damage Control to Mon 11:00 C04; all five required drills are covered. Repeated, cross-week and overdue occurrences are visible. Real SFTRM, formats and operational rules remain unvalidated.",
      "journeyIds": [
        "weekly-resolution",
        "qualification-recovery",
        "availability-recovery",
        "recurrence-coverage",
        "overdue-recovery",
        "fatigue-policy"
      ]
    },
    {
      "criterionId": "SCH-01",
      "disposition": "implemented",
      "expectedOutcome": "The baseline retains all five drills with zero personnel or resource interval overlaps and explicitly reports the resolved Damage Control collision. A conflicting board edit is rejected on validation and corrected without losing the occurrence.",
      "journeyIds": [
        "weekly-resolution",
        "edit-review"
      ]
    },
    {
      "criterionId": "SCH-02",
      "disposition": "implemented",
      "expectedOutcome": "Assignments meet explicit qualifications, crew/resource/ship availability, distinct role counts, daily/weekly duty and synthetic block/rest limits including prior duty. Missing EOOW and unavailable flight crew block acceptance until corrected. A 4.5h daily load fails a 4h limit and passes only after a deliberate versioned synthetic policy edit to 4.5h; hard constraints never relax automatically.",
      "journeyIds": [
        "qualification-recovery",
        "availability-recovery",
        "fatigue-policy"
      ]
    },
    {
      "criterionId": "SCH-03",
      "disposition": "implemented",
      "expectedOutcome": "An impossible DC deadline is reported infeasible over supplied candidates, a node budget of 1 reports search exhausted with feasibility unresolved, and budget 0 is invalid input. None authorizes acceptance. Correction to budget 50000 yields all five baseline occurrences; stopping preserves inputs without accepting a new schedule.",
      "journeyIds": [
        "search-recovery",
        "invalid-and-stop"
      ]
    },
    {
      "criterionId": "SCH-04",
      "disposition": "implemented",
      "expectedOutcome": "Synthetic recurrence and explicit history expand into stable required occurrences: baseline five weekly drills; two-day DC fixture eight total with four DC deadlines, including DC-4 on 16 Nov due 17 Nov 00:00 beyond the displayed week. An overdue DC-0 remains uncovered and blocks acceptance until explicit fictional completion history is recorded. No real SFTRM integration or certification is claimed.",
      "journeyIds": [
        "recurrence-coverage",
        "overdue-recovery"
      ]
    },
    {
      "criterionId": "SCH-05",
      "disposition": "implemented",
      "expectedOutcome": "The operator reviews an editable board, load heatmap, conflicts and every explicit relaxation request, then deliberately records synthetic acceptance of a valid complete revision with reviewer alias. Acceptance persists across reload; an unsaved conflicting draft blocks acceptance, committed edits invalidate the old review, and only a revalidated revision can be accepted. This interaction is not actual human prototype acceptance or operational authority.",
      "journeyIds": [
        "review-export",
        "edit-review",
        "fatigue-policy"
      ]
    },
    {
      "criterionId": "DELIVERABLE11-1",
      "disposition": "implemented",
      "expectedOutcome": "A self-contained interactive Weekly PB4T Schedule Board provides one-click Optimize schedule, five departmental negotiation records, Conflict and Resolution Report, Periodicity Coverage Report, Personnel Loading Heatmap and Synthetic Schedule Review Record and Export. The literal baseline assignments yield weekly loads C01=2h, C02=1h, C03=1h, C04=2h, C05=0h, C06=1h; a readable download contains the same accepted revision, assignments, loads and synthetic warning. Optimization denotes bounded feasibility, with no global optimality claim.",
      "journeyIds": [
        "weekly-resolution",
        "review-export",
        "edit-review"
      ]
    }
  ],
