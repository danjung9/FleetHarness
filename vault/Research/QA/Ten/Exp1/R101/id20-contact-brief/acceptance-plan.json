{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC20-1",
      "disposition": "deferred",
      "expectedOutcome": "Real unclassified AIS, IMO registry, OFAC and EU snapshots are ingested with lawful provenance. This real-data requirement remains unverified. The implemented synthetic companion workflow ingests all named source families plus port logs, resolves Name/IMO/MMSI and exports the complete Cited Contact Brief, Identity Resolution Record and Evidence Appendix, exercised under UC20-2.",
      "journeyIds": [],
      "deferralBasis": "real-data",
      "reason": "Approved real AIS, IMO registry, OFAC/EU snapshots with provenance and permitted usage are absent and prohibited by this synthetic-only workspace. Fictional snapshots demonstrate the full workflow but cannot establish real open-source grounding; live acquisition also needs separately authorized connectors."
    },
    {
      "criterionId": "UC20-2",
      "disposition": "implemented",
      "expectedOutcome": "In the explicitly synthetic complete workflow, every factual brief claim resolves to a permitted exact original span, revision, capture and observation timestamps and a verified captured-content digest; unsupported intent, flag, sanctions applicability and conflicting AIS remain UNKNOWN. Same-name identities require deliberate selection. The Cited Contact Brief exports with a resolvable offline Evidence Appendix and Identity Resolution Record. Integrity failures block affected claims and export; local review preserves saved and unsaved interpretation separately. Synthetic evaluation is generated, but this does not establish real-format compliance, production immutability, owner acceptance or operational validation.",
      "journeyIds": [
        "brief-export",
        "ambiguous-name",
        "input-recovery",
        "missing-stale",
        "permitted-evidence",
        "integrity-recovery",
        "import-conflict",
        "review-boundary",
        "synthetic-evaluation"
      ]
    },
    {
      "criterionId": "RET-01",
      "disposition": "implemented",
      "expectedOutcome": "The denied snapshot is the strongest unfiltered lexical match but is removed before identity matching, retrieval, viewing and export. ALDER REACH owner North Lantern returns only REG-A and its exact owner span; no denied content or unsupported claims appear in any result or portable export. An allowed flag is a synthetic filtering fixture, not authorization.",
      "journeyIds": [
        "permitted-evidence",
        "brief-export"
      ]
    },
    {
      "criterionId": "RET-02",
      "disposition": "implemented",
      "expectedOutcome": "The fixed synthetic as-of and more-than-30-day policy expose PORT-A observation as STALE despite fresh capture; OFAC observation time and absent flag, EU applicability and intent are UNKNOWN. One future snapshot is excluded. No-match and conflicting AIS conclusions abstain; restoration and corrected identifiers recover without guessed facts.",
      "journeyIds": [
        "missing-stale",
        "input-recovery",
        "import-conflict"
      ]
    },
    {
      "criterionId": "RET-03",
      "disposition": "deferred",
      "expectedOutcome": "An actual owner reviews held-out labels, relevance and latency measurements, with corpus size, runtime/hardware, sample count, measured boundary and percentiles recorded. The synthetic evaluation report and safety-case measurements are implemented as companion evidence under UC20-2, but evaluation with an owner remains unverified.",
      "journeyIds": [],
      "deferralBasis": "human-authority",
      "reason": "No participating owner can review labels, assess relevance or accept measured results in this unattended run. The local report explicitly says PENDING; synthetic labels and automated timing cannot substitute for that person\u2019s participation."
    }
  ],
