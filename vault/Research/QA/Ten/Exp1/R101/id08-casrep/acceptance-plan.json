{
  "schemaVersion": 1,
  "criteria": [
    {
      "criterionId": "UC8-1",
      "disposition": "implemented",
      "expectedOutcome": "The complete synthetic CASREP uses all six simulated roles, required fields, categories 2/3/4 and INITIAL/UPDATE/CORRECT/CASCOR previews; a returned draft is revised, reviewed and simulated-released with visible holder, comments and revision-bound approvals. Linked amendments preserve released snapshots. This demonstrates assumed format checks only, not validated NWP 1-03.1 compliance or operational rules.",
      "journeyIds": [
        "route-return-release",
        "invalid-fields",
        "stale-approval",
        "local-draft",
        "linked-lifecycle"
      ]
    },
    {
      "criterionId": "WFL-01",
      "disposition": "implemented",
      "expectedOutcome": "Out-of-order CO release and dirty-form review are rejected; content changes invalidate earlier approvals and require a new complete route before simulated release.",
      "journeyIds": [
        "stale-approval",
        "local-draft"
      ]
    },
    {
      "criterionId": "WFL-02",
      "disposition": "implemented",
      "expectedOutcome": "Two competing amendments visibly retain restoration 20:00Z and the fictional seal-kit request; unresolved conflict blocks release, explicit reconciliation retains both parents through reload and exports their history with the final release.",
      "journeyIds": [
        "conflict-recovery"
      ]
    },
    {
      "criterionId": "WFL-03",
      "disposition": "implemented",
      "expectedOutcome": "An evaluator can perform intake, comment, return, revise, all approvals and local export, and recover invalid inputs without losing the draft. Automated journeys do not claim that a human reviewer has accepted the workflow.",
      "journeyIds": [
        "route-return-release",
        "release-package",
        "invalid-fields"
      ]
    },
    {
      "criterionId": "DELIVERABLE8-1",
      "disposition": "implemented",
      "expectedOutcome": "One mock CASREP traverses Sailor/LPO, Division Officer, Department Head, Engineer Officer/CHENG, XO and CO with a return loop. Named synthetic message/history downloads, a live walkthrough and a one-page fielding brief cover permissions, classification, Navy messaging boundaries and fielding prerequisites; release remains a local simulation.",
      "journeyIds": [
        "route-return-release",
        "conflict-recovery",
        "release-package"
      ]
    }
  ],
