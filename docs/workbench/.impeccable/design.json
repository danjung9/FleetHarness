      "refersTo": "button-secondary",
      "description": "A white bordered action for edits, refreshes, and alternate downloads.",
      "html": "<button class=\"ds-button\">Edit request</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:37px;padding:8px 13px;border:1px solid #ced7e4;border-radius:6px;background:#fff;color:#34445b;font:500 12px/1.5 \"DM Sans\",sans-serif;text-decoration:none;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-button:hover{background:#f0f4fa;border-color:#aebed3}.ds-button:focus-visible{outline:2px solid var(--blue,#275ac3);outline-offset:3px}.ds-button:disabled{cursor:not-allowed;opacity:.48}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "One shared focus boundary around an icon, editable query, and shortcut hint.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 4 4\"/></svg><input aria-label=\"Search challenges\" placeholder=\"Search a task or problem…\"/><kbd>/</kbd></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid #c7d1df;border-radius:6px;min-height:39px;background:#fff;color:#69788d;max-width:440px}.ds-search:focus-within{outline:2px solid var(--blue,#275ac3);outline-offset:2px}.ds-search input{min-width:0;width:100%;border:0;border-radius:0;padding:8px 0;background:transparent;outline:0;color:var(--ink,#202d3e);font:400 13px/1.5 \"DM Sans\",sans-serif;caret-color:var(--blue,#275ac3)}.ds-search input::placeholder{color:#687588}.ds-search kbd{font:11px \"IBM Plex Mono\",monospace;padding:0 5px;border:1px solid var(--line,#dfe5ed);border-radius:3px;color:var(--muted,#5b6779)}"
    },
    {
      "name": "Active navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "A labeled destination with a count; compact mode must preserve its accessible name.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#catalog\" aria-current=\"page\" aria-label=\"Find a solution (34)\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"5\" height=\"5\" rx=\"1\"/><path d=\"M12 5h9M12 9h9M3 15h5M3 19h5M12 15h9M12 19h9\"/></svg><span>Find a solution</span><span class=\"ds-count\">34</span></a></nav>",
      "css": ".ds-nav{width:188px;background:#f4f6fa;padding:8px}.ds-nav a{display:flex;gap:11px;align-items:center;min-height:42px;padding:11px 10px;border-radius:6px;text-decoration:none;font:500 12px \"DM Sans\",sans-serif;color:#536074}.ds-nav a:hover{background:#e9eef6;color:#203f7a}.ds-nav a[aria-current=page]{background:#e3ebfb;color:#214fba}.ds-nav a:focus-visible{outline:2px solid var(--blue,#275ac3);outline-offset:3px}.ds-count{margin-left:auto;font-size:11px;font-variant-numeric:tabular-nums}"
    },
