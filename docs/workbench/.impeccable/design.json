    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A compact cobalt action for saving, creating, trying, or approving a tool.",
      "html": "<button class=\"ds-button ds-primary\">Save request<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:37px;padding:8px 13px;border:1px solid #ced7e4;border-radius:6px;background:#fff;color:#34445b;font:500 12px/1.5 \"DM Sans\",sans-serif;text-decoration:none;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-button:hover{background:#f0f4fa;border-color:#aebed3}.ds-button:focus-visible{outline:2px solid var(--blue,#275ac3);outline-offset:3px}.ds-button:disabled{cursor:not-allowed;opacity:.48}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--blue,#275ac3);border-color:var(--blue,#275ac3);color:#fff}.ds-primary:hover{background:#19489f;border-color:#19489f}"
    },
    {
      "name": "Secondary button",
